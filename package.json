{
  "name": "phplens",
  "version": "1.1.0",
  "private": true,
  "description": "Browser extension that passively checks the PHP version a website's server advertises and warns when it is unpatched or end-of-life.",
  "homepage": "https://github.com/Haniamin90/phplens#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Haniamin90/phplens.git"
  },
  "bugs": {
    "url": "https://github.com/Haniamin90/phplens/issues"
  },
  "scripts": {
    "icons": "node tools/gen-icons.mjs",
    "build": "node tools/gen-icons.mjs && node tools/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "demo": "node tools/demo-server.mjs",
    "lint:firefox": "npx --yes web-ext lint --source-dir dist/firefox",
    "run:firefox": "npx --yes web-ext run --source-dir dist/firefox",
    "sign:firefox": "npx --yes web-ext sign --source-dir dist/firefox --artifacts-dir dist/signed --channel listed --amo-metadata store/amo-metadata.json",
    "release": "npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
